# ==============================================================================
# CAn Client - Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Service Provider (ESP) API Credentials (Klaviyo / Mailchimp / Loops)
ESP_PROVIDER=mock
ESP_API_KEY=your_esp_api_key_here
ESP_LIST_ID=your_newsletter_list_id_here

# Telemetry & Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_POSTHOG_KEY=

# Asset CDN (Cloudflare R2 / AWS S3 / Vercel Blob)
NEXT_PUBLIC_ASSET_CDN_URL=
